# 全网查询计数后端（Cloudflare Worker + KV）。
# GitHub Pages 与 Cloudflare Pages 两个部署共用同一个 Worker。
# 留空则使用代码内置默认值（生产 Worker）。
VITE_WORKER_URL=https://counter.dingyi.de

# Cap 安全验证后端（与计数同一个 Worker 的 /cap/* 路由）。
# 留空则使用代码内置默认值（dev 指向 localhost:8787 wrangler dev，生产为 counter.dingyi.de）。
VITE_CAPTCHA_WORKER_URL=https://counter.dingyi.de
