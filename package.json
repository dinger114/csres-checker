{
  "name": "csres-checker",
  "type": "module",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@cap.js/widget": "^0.1.58",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx,mjs,cjs,json,md,css,html}": "eslint --fix"
  }
